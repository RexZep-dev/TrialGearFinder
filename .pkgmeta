# Указания упаковщику BigWigsMods/packager.
#
# package-as задаёт имя ПАПКИ ВНУТРИ архива. Для аддонов WoW это обязательно:
# игре нужна папка, а не файлы россыпью в корне zip. Правило «zip the contents
# directly» с их справки к аддонам читать буквально нельзя - на этом уже
# спотыкались при сборке 1.0.0 руками.
package-as: TrialGearFinder

# Внешних библиотек у аддона нет, поэтому отдельная сборка «без библиотек»
# не нужна - она бы просто дублировала основную.
enable-nolib-creation: no

# В архив к игроку не кладём то, что нужно только разработке.
ignore:
  - .github
  - .pkgmeta
  - README.md
