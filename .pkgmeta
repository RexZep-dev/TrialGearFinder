# Указания упаковщику BigWigsMods/packager.
#
# package-as задаёт имя ПАПКИ ВНУТРИ архива. Для аддонов WoW это обязательно:
# игре нужна папка, а не файлы россыпью в корне zip. Правило «zip the contents
# directly» с их справки к аддонам читать буквально нельзя - на этом уже
# спотыкались при сборке 1.0.0 руками.
package-as: TrialGearFinder

# Внешних библиотек у аддона нет, поэтому отдельная сборка «без библиотек»
# не нужна - она бы просто дублировала основную.
enable-nolib-creation: no

# В архив к игроку не кладём то, что нужно только разработке.
ignore:
  - .github
  - .pkgmeta
  - README.md

# Список изменений для CurseForge - свой, человеческим языком. Без этого
# упаковщик собирает его из заголовков коммитов, а к 1.1.0 их почти двести,
# вперемешку с технической кухней. Файла нет - упаковщик соберёт сам.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Модули - отдельные папки в AddOns у игрока. В репозитории они подпапки
# ядра: рабочая копия - одна папка. Упаковщик выносит их наверх архива.
move-folders:
  TrialGearFinder/TrialGearFinder_Builds: TrialGearFinder_Builds
  TrialGearFinder/TrialGearFinder_Journal: TrialGearFinder_Journal
